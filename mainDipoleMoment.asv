%% Magnetic Dipole Moment with Saturation for Hiperco 50A Rod
clear; clc;

%% Parameters
mu0 = 1.257*1e-6;          % Air permeability [H/m]
mu_r = 3500;              % Relative permeability of Hiperco 50A (linear region)
N_wire = 3210;            % # of wiring
B_sat = 2.35;             % Saturation flux density [T]
l_mag = 0.15;             % Core length [m]
r_mag = 0.005;            % Core diameter [m]
d_copper = 0.00032;       % Diameter of copper wire
r_copper = 1.72e-8;       % Resistivity of copper

% The demagnetization factor
N_d = (4. * log(l_mag/r_mag)-1)/((l_mag/r_mag)^2 - 4. * log(l_mag/r_mag));

filename = 'Tor-Dyn-25-10 Test Results.xlsx';    % Here we set .xlsx filename
Magnetorquer_Test_Results = xlsread(filename);   % Here we read the data

V = Magnetorquer_Test_Results(:,1); % Voltage applied 
I = Magnetorquer_Test_Results(:,2); % Measure current 
H_0 = N_wire * I / l_mag;           % The magnetizing field
B = Magnetorquer_Test_Results(:,3); % Magnetic field current 
H_t = B / (1000 * mu0);             % Transmitted Magnetizing field    


figure;

subplot(4,1,1) % 3 rows, 1 column, plot 1
plot(V, I)
title('Voltage vs Current for Tor-Dyn-25-10 with resistance 34.6 \Omega')
xlabel('Voltage (V)')
ylabel('Current (A)')
daspect([2 1 1])
grid on

subplot(4,1,2) % plot 2
plot(I, H_0)
title('Magnetizing Field vs Current for Tor-Dyn-25-10 with 3210 windings and 15 cm length')
xlabel('Current (A)')
ylabel('H_0 (A/m)')
xlim([min(I) max(I)])
grid on

subplot(4,1,3) % plot 3
plot(H_0, B)
title('Magnetic Field vs Magnetizing Field for Tor-Dyn-25-10 with HyperCo 50A core')
xlabel('H_0 (A/m)')
ylabel('B (mT)')
xlim([min(H_0) max(H_0)])
grid on

subplot(4,1,4) % plot 3
plot(H_0, H_t)
title('Transmitted Magnetizing vs Magnetizing Field for Tor-Dyn-25-10 with HyperCo 50A core')
xlabel('H_0 (A/m)')
ylabel('H_t (A/m)')
xlim([min(H_0) max(H_0)])
grid on

mu_r = zeros(length(H_0),1); % Permeability
mu_eff = zeros(length(H_0),1); % Permeability
H_f = zeros(length(H_0),1); % Permeability
M_f = zeros(length(H_0),1); % Permeability
B_calc = zeros(length(H_0),1); % Permeability

for i = 1:length(H_0)
    %H_f(i) = getHFieldHTangentModel( N_d, H_0(i) ); % Magnetizing field
    H_f(i) = getHfieldLangevinModel( N_d, H_0(i) );  % Magnetizing field 
    M_f(i) = (H_0(i)-H_f(i))/N_d;                    % Magnetization
    mu_r(i) = B(i) /( mu0 * H_f(i)) ;         % Relative Permeability
    B_calc(i) = 1000. * mu0 * (H_f(i) + M_f(i));     % Model Magnetic Field
end

% Here we fit the relative permability
mu_fit = permeabilityModelFit( mu_r, H_f );

figure;
plot(H_f, mu_fitted)
hold on
plot(H_f, mu_r,'r*')
title('Relative Permeability for Tor-Dyn-25-10')
xlabel('H_{eff} (A/m)')
ylabel('\mu_r')
legend('Fitted Permeability', 'Measurement Data')
grid on

figure;
plot(H_0,H_f,'b')
hold on
plot(H_0,M_f,'r')
title('Effective Magnetizing Field for Tor-Dyn-25-10')
xlabel('H_0 (A/m)')
ylabel('A/m')
legend('Effective Magnetizing Field', 'Magnetization')
grid on

figure;
plot(H_0,B_calc,'b')
hold on
plot(H_0,B,'r*')
title('Measured vs Model Magnetic Field for Tor-Dyn-25-10')
xlabel('H_0 (A/m)')
ylabel('B (mT)')
legend('Model', 'Measured')
grid on
